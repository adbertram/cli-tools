# Shape only. auth login and auth client import store reusable app credentials
# in the CLI-tools secret manager; never paste secret values into .env files.
BASE_URL=https://googleads.googleapis.com
CUSTOMER_ID=
LOGIN_CUSTOMER_ID=
LINKED_CUSTOMER_ID=
# Profile-owned runtime state is written by auth commands:
# CLIENT_ID=secret://google-ads-client-id
# CLIENT_SECRET=secret://google-ads-client-secret
# ACCESS_TOKEN= (managed OAuth state)
# REFRESH_TOKEN= (managed OAuth state)
# TOKEN_EXPIRES_AT= (managed OAuth state)
# REDIRECT_URI=http://localhost

ACTIVE=true

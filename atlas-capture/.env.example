# Atlas Capture CLI configuration
ACTIVE=true

# Non-authentication configuration
BASE_URL=https://audit.atlascapture.io

# Runtime only (not a secret):
# HEADLESS=false   -> run `auth login` HEADED (required: Cloudflare Turnstile
#                     mints its token only in a headed browser).
# ATLAS_CAPTURE_EMAIL=you@example.com   -> override the reusable
#                     atlas-capture-email secret for one-off runs.
#
# Reusable credentials (never here): the account login email is stored in the
# CLI-tools secret manager as `atlas-capture-email` — see
# <cli-tools-root>/_repo/_secret-manager/secrets.sh.

# Mailchimp API Credentials
# Get your API key from: https://us1.admin.mailchimp.com/account/api/
# API key format: key-dc (e.g., abc123def456-us6)
# The data center (dc) is extracted automatically from the API key

ACTIVE=true

# API Key (required for authentication)
# Format: your-key-here-datacenter (e.g., abc123-us6)
MAILCHIMP_API_KEY=

# OAuth Credentials (optional - for building apps for other users)
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=

# API Base URL (optional - auto-detected from API key)
# Only set this if you need to override the default
# MAILCHIMP_BASE_URL=https://usX.api.mailchimp.com/3.0

# OAuth Tokens (populated automatically after OAuth login)
MAILCHIMP_ACCESS_TOKEN=
MAILCHIMP_REFRESH_TOKEN=
MAILCHIMP_TOKEN_EXPIRES_AT=

# Clipster CLI configuration
ACTIVE=true

# Non-authentication configuration
BASE_URL=https://api.clipster.gg

# Authentication (written by `clipster auth login`; never edit by hand)
# EMAIL is stored in the CLI-tools secret manager as clipster-email and
# referenced here as secret://clipster-email.
EMAIL=
# Session tokens are runtime state written by login and automatic refresh.
ACCESS_TOKEN=
REFRESH_TOKEN=
TOKEN_EXPIRES_AT=
REFRESH_EXPIRES_AT=

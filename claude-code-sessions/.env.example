# ClaudeCodeSessions CLI Wrapper Configuration
# Documentation: 

# Set to 1 for the default profile
IS_DEFAULT_PROFILE=1

# Underlying CLI command (defaults to claude)
# CLAUDE_CODE_SESSIONS_CLI_COMMAND=claude

# Optional: Full path to CLI executable (if not in PATH)
# CLAUDE_CODE_SESSIONS_CLI_PATH=/usr/local/bin/claude

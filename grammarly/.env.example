# Grammarly API Credentials
# Get these from: https://developer.grammarly.com/

IS_DEFAULT_PROFILE=1

# OAuth Client Credentials (required)
# Prompted during 'grammarly auth login' and saved automatically.
GRAMMARLY_CLIENT_ID=
GRAMMARLY_CLIENT_SECRET=

# OAuth Tokens (populated automatically after first API call)
GRAMMARLY_ACCESS_TOKEN=
GRAMMARLY_TOKEN_EXPIRES_AT=

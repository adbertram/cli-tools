# Digicert API Credentials
# Get these from: https://dev.digicert.com/en/get-started/about-the-apis.html
IS_DEFAULT_PROFILE=1

# API Key (if using API key auth)
API_KEY=

# Personal Access Token (if using PAT auth)
PERSONAL_ACCESS_TOKEN=

# OAuth Credentials (if using OAuth)
CLIENT_ID=
CLIENT_SECRET=

# API Base URL (optional - defaults to production)
BASE_URL=https://www.digicert.com/partners/value-added-reseller-affiliate/

# OAuth Tokens (populated automatically after login)
ACCESS_TOKEN=
REFRESH_TOKEN=
TOKEN_EXPIRES_AT=

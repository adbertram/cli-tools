# Outlier CLI configuration
#
# Outlier has NO password, API key, or token: sign-in is a one-time link
# emailed to ACCOUNT_EMAIL. Nothing here is a credential, so nothing here
# belongs in the CLI-tools secret manager. Reusable human-supplied secrets for
# any CLI live in <cli-tools-root>/_repo/_secret-manager/secrets.sh; only
# CLI-managed runtime auth state belongs under
# ~/.local/share/cli-tools/outlier/authentication_profiles/<profile>/.
ACTIVE=true

# Non-authentication configuration
BASE_URL=https://app.outlier.ai

# Address Outlier mails the passwordless sign-in link to. Required by
# `outlier auth login`. Lives in ~/.local/share/cli-tools/outlier/.env.
ACCOUNT_EMAIL=

# Vues CLI configuration (shape only; never put secrets here)
ACTIVE=true

# Non-authentication configuration
BASE_URL=https://api.evrgreen.ai

# Authentication: Vues signs in only with Google or Apple (Supabase).
# `vues auth login` opens a browser for the provider sign-in, then captures the
# Supabase session. These token fields are runtime auth state written by login
# and automatic refresh; never edit them by hand and never store reusable
# credentials in any .env file.
SUPABASE_ACCESS_TOKEN=
SUPABASE_REFRESH_TOKEN=
SUPABASE_EXPIRES_AT=

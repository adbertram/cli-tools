# Set to 1 for the default profile
ACTIVE=true
AUTH_TYPE=custom

# X API OAuth 1.0a Credentials (required for posting tweets)
# Get these from: https://developer.x.com/en/portal/dashboard
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Browser-session profiles use AUTH_TYPE=browser_session for Developer Console
# actions such as adding API credits.

# FreshBooks CLI - Required Credentials
# Copy this file to .env and fill in your values

IS_DEFAULT_PROFILE=1

# Your FreshBooks account ID (found in URL: https://my.freshbooks.com/#/account/<ACCOUNT_ID>)
ACCOUNT_ID=

# OAuth2 credentials (from FreshBooks Developer Portal)
CLIENT_ID=
CLIENT_SECRET=

# OAuth2 tokens (obtained after authentication via 'freshbooks auth login')
ACCESS_TOKEN=
REFRESH_TOKEN=
TOKEN_EXPIRES_AT=

# Optional: OAuth redirect URI (default: https://localhost/callback)
REDIRECT_URI=

# Default payment terms (auto-added to all new invoices)
# Use \n for newlines in the terms text
# Example: DEFAULT_TERMS="Payment due within 30 days.\n\nBank details:\nAccount: 12345"
DEFAULT_TERMS=

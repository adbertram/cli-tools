# Bricklink API Credentials
# Get these from: https://www.bricklink.com/v3/api.page
IS_DEFAULT_PROFILE=1

# API Key (if using API key auth)
API_KEY=

# Personal Access Token (if using PAT auth)
PERSONAL_ACCESS_TOKEN=

# OAuth Credentials (if using OAuth)
CLIENT_ID=
CLIENT_SECRET=

# API Base URL (optional - defaults to production)
BASE_URL=https://api.bricklink.com/api/store/v1

# OAuth Tokens (populated automatically after login)
ACCESS_TOKEN=
REFRESH_TOKEN=
TOKEN_EXPIRES_AT=

# Response cache settings
# Enable/disable data-level caching (default: true)
CACHE_ENABLED=true
# Cache time-to-live in seconds (default: 3600)
CACHE_TTL=3600

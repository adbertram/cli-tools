# Upwork CLI configuration
ACTIVE=true

# Non-authentication configuration
BASE_URL=https://www.upwork.com

# Optional OAuth redirect URI override for the GraphQL API (non-secret).
# Register this EXACT value on your Upwork developer app. Defaults to
# http://localhost:8765/callback when unset.
# REDIRECT_URI=http://localhost:8765/callback

# Optional GraphQL endpoint override (non-secret). Defaults to
# https://api.upwork.com/graphql when unset.
# GRAPHQL_URL=https://api.upwork.com/graphql

# NOTE: CLIENT_ID and CLIENT_SECRET are reusable secrets and must NOT live here.
# Provide them via `upwork auth login` (stored in the profile) or the
# CLI-tools secret manager. Never commit them.

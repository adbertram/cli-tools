# Hyvor API Credentials
# Get these from: https://talk.hyvor.com/docs/api-console

# API Key - Required for authentication
# Create at Console → Settings → API
API_KEY=

# Website ID - Required for all API calls
# Find in Console → Settings → Website ID
WEBSITE_ID=

# API Base URL (optional - defaults to production)
BASE_URL=https://talk.hyvor.com/api/console/v1

# Profile management
ACTIVE=true

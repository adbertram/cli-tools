# Freshworks API Credentials
# Get these from: https://developers.freshworks.com/docs/app-sdk/v3.0/support_ticket/rest-apis/
IS_DEFAULT_PROFILE=1

# API Key (if using API key auth)
API_KEY=

# Personal Access Token (if using PAT auth)
PERSONAL_ACCESS_TOKEN=

# OAuth Credentials (if using OAuth)
CLIENT_ID=
CLIENT_SECRET=

# API Base URL (optional - defaults to production)
BASE_URL=https://www.freshworks.com/

# OAuth Tokens (populated automatically after login)
ACCESS_TOKEN=
REFRESH_TOKEN=
TOKEN_EXPIRES_AT=

# TikTok CLI profile configuration
ACTIVE=true

# Choose exactly one profile auth type:
# AUTH_TYPE=browser_session
# AUTH_TYPE=custom
AUTH_TYPE=

CLIENT_KEY=
CLIENT_SECRET=
# Redirect URI must start with https:// — TikTok rejects http://localhost.
# Register the exact same URI in the TikTok developer portal.
REDIRECT_URI=
ACCESS_TOKEN=
REFRESH_TOKEN=
TOKEN_EXPIRES_AT=
OPEN_ID=
# Scopes the TikTok portal actually offers: video.upload = drafts/inbox,
# video.publish = Direct Post to the feed. There is no comment-posting scope.
SCOPES=user.info.basic,video.upload,video.publish
GRANTED_SCOPES=

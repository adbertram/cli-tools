# Snagit CLI Configuration
# No credentials required - this CLI works with local .snagx files

IS_DEFAULT_PROFILE=1

# Default Snagit captures location (can be overridden with --path option)
# Default: ~/Pictures/Snagit/Autosaved Captures.localized/
# SNAGIT_CAPTURES_PATH=/Users/adam/Pictures/Snagit/Autosaved Captures.localized/

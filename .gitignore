# Environment variables (all .env files)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
*.egg-info/

# progress-servicenow ships as preserved bytecode (original source was lost); track its restored modules.
!_personal/progress-servicenow/progress_servicenow_cli/_bytecode_cache/*.pyc
!_personal/progress-servicenow/progress_servicenow_cli/*/_bytecode_cache/*.pyc

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Separate repositories (have their own .git)
coursecraft/
snagit/
youtube/

# TikTok clipping lifecycle compliance; preserve n8n local artifacts.
scripts/*.log
authentication_profiles/
n8n/**/.profiles/
n8n/dist/
n8n/build/
n8n/plans/
n8n/agent_workspaces/
n8n/_temp/

# Browser profiles, cookie stores, API caches, test droppings, and downloaded
# logs hold credentials or private data; this repo is public, never commit them.
**/.profiles/
**/.storage/
chromium-profile/
*/cache/
MagicMock/
_personal/azlogs/data/

# YouTube CLI Configuration
#
# Required only for `youtube channel videos ...` commands that talk to the
# YouTube Data API v3 (list / get / upload / update / delete on the
# authenticated user's channel). Downloads, transcripts, and subtitle
# commands use yt-dlp and do NOT require these credentials.
#
# Create OAuth credentials at:
#   https://console.cloud.google.com/apis/credentials
#   Click 'Create Credentials' > 'OAuth client ID' > type: 'Desktop app'
# Then enable the YouTube Data API v3 in the same project.

AUTH_TYPE=
CLIENT_ID=
CLIENT_SECRET=

IS_DEFAULT_PROFILE=1

# {{Name}} Configuration
# Browser session data is stored in the active profile directory.
ACTIVE=true

# Optional: override the default site URL
BASE_URL={{base_url}}

# Optional: set to false to watch the browser during local debugging
HEADLESS=true

# Optional browser-harness runtime settings
# BROWSER_USER_AGENT=
# BROWSER_WINDOW_SIZE=1440,900

# Response cache settings
# Enable/disable response caching (default: true)
CACHE_ENABLED=true
CACHE_TTL=3600

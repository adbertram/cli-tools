    "classifieds": {
      "help": "Browse the For Sale & Free classifieds",
      "arguments": [],
      "options": [],
      "commands": {
        "get": {
          "help": "Get one For Sale & Free listing with its full description and details.",
          "arguments": [
            {
              "name": "classified_id",
              "type": "TEXT",
              "required": true,
              "help": "Listing ID (the UUID in the listing URL)"
            }
          ],
          "options": [
            {
              "name": "--table",
              "type": "bool",
              "required": false,
              "help": "Display as table",
              "short": "-t"
            },
            {
              "name": "--properties",
              "type": "TEXT",
              "required": false,
              "help": "Comma-separated fields to include",
              "short": "-p"
            }
          ]
        },
        "list": {
          "help": "List For Sale & Free listings with their direct listing URLs. QUERY is Nextdoor's own For Sale & Free keyword box, not a filter. Nextdoor ranks results by relevance and applies no relevance floor, so a keyword with little or no local inventory comes back padded with unrelated listings, and the same keyword can return a different row count on consecutive runs. Add ``--filter \"type:eq:ORGANIC,title:contains:<keyword>\"`` when the caller needs rows that actually contain the keyword.",
          "arguments": [
            {
              "name": "query",
              "type": "QUERY",
              "required": false,
              "help": "Relevance keyword, NOT a filter (default: browse all). See description"
            }
          ],
          "options": [
            {
              "name": "--limit",
              "type": "INTEGER",
              "required": false,
              "help": "Maximum number of listings",
              "short": "-l",
              "default": "25"
            },
            {
              "name": "--sort",
              "type": "TEXT",
              "required": false,
              "help": "Sort field: 'newest' (default; most recent first, server-side) or 'relevance' (Nextdoor's 'Most Relevant' order)",
              "short": "-s",
              "default": "newest"
            },
            {
              "name": "--desc",
              "type": "bool",
              "required": false,
              "help": "Reverse the sort's natural order (newest -> oldest-first, over the fetched pages)",
              "short": "-d"
            },
            {
              "name": "--filter",
              "type": "TEXT",
              "required": false,
              "help": "Filter results (field:op:value)",
              "short": "-f"
            },
            {
              "name": "--table",
              "type": "bool",
              "required": false,
              "help": "Display as table",
              "short": "-t"
            },
            {
              "name": "--properties",
              "type": "TEXT",
              "required": false,
              "help": "Comma-separated fields to include",
              "short": "-p"
            }
          ]
        }
      }

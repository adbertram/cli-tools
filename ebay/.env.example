ACTIVE=true
BASE_URL=https://api.ebay.com

# eBay OAuth App Credentials (from https://developer.ebay.com/my/keys)
CLIENT_ID=
CLIENT_SECRET=

# Redirect URI (RuName from eBay Developer Portal)
# This must match exactly what's configured in your eBay app
REDIRECT_URI=

# Environment: "sandbox" or "production"
ENVIRONMENT=production

# OAuth Tokens (populated automatically after 'ebay auth login')
ACCESS_TOKEN=
REFRESH_TOKEN=
TOKEN_EXPIRES_AT=

# Response cache. Only completed/sold marketplace search is cached, and sold
# comps are historical, so the window is one week (604800 seconds) — the same
# staleness BrickBuddy uses against the same provider. Active-listing search is
# never cached. Bypass a single run with the global --no-cache flag; wipe the
# stored answers with `ebay cache clear`.
CACHE_TTL=604800

# Default Ship-From Address
FROM_NAME=
FROM_STREET=
FROM_CITY=
FROM_STATE=
FROM_ZIP=
FROM_COUNTRY=US
FROM_PHONE=

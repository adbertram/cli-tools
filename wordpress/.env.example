IS_DEFAULT_PROFILE=1

# WordPress Application Password Authentication
# Generate an Application Password in WordPress:
# Users > Profile > Application Passwords

# WordPress site URL (required)
URL=

# WordPress REST API base URL (auto-constructed from URL if not set)
BASE_URL=

# WordPress username (required) -- prompted by 'wordpress auth login'
USERNAME=

# WordPress Application Password (required) -- prompted by 'wordpress auth login'
# NOTE: This is NOT your account password!
# Generate in WordPress admin: Users > Profile > Application Passwords
# Stored under PASSWORD; APP_PASSWORD is accepted as a legacy synonym.
PASSWORD=

# Optional secondary WordPress.com credential bundle for native Jetpack plugin upgrades.
# Save interactively with:
#   wordpress org token save-credential --client-id ... --client-secret ... --username ... --password ... --site ...
# Acquire and save a token with:
#   wordpress org token
WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=
WPCOM_USERNAME=
WPCOM_PASSWORD=
WPCOM_SITE=
WPCOM_ACCESS_TOKEN=
WPCOM_TOKEN_TYPE=
WPCOM_SCOPE=

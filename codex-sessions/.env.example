# CodexSessions CLI Wrapper Configuration
# Documentation: https://github.com/openai/codex
ACTIVE=true

# Underlying CLI command (defaults to codex)
CLI_COMMAND=codex

# Optional: Full path to CLI executable (if not in PATH)
# CLI_PATH=

# Optional: primary Codex home. Defaults to ~/.codex. Named profile roots under
# <base>/profiles/<name> are searched too. A CODEX_HOME that points at one
# profile is promoted to its base home for the default all-profile search.
# CODEX_HOME=~/.codex

# Optional: scope reads to one named Codex profile.
# CODEX_SESSIONS_CODEX_PROFILE=deepseek

# Optional: scope reads to one explicit Codex root. Takes precedence over the
# Codex profile selector.
# CODEX_SESSIONS_CODEX_HOME=~/.codex

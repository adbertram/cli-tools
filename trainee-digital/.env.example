# TraineeDigital CLI configuration (shape only -- never real credentials)
ACTIVE=true

# Non-authentication configuration
BASE_URL=https://trainee.digital

# The account email Clerk mails the login code to. Configuration, not a
# credential: trainee.digital has no stored password for this account.
ACCOUNT_EMAIL=you@example.com

# Browser automation (true = invisible headless, false = visible browser)
HEADLESS=true

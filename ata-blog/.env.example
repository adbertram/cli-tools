# AtaBlog CLI Wrapper Configuration

# Underlying CLI command (defaults to wordpress)
CLI_COMMAND=wordpress

# Optional: Full path to CLI executable (if not in PATH)
# CLI_PATH=

# Notion Database ID for articles
NOTION_DATABASE_ID=

# Default values
DEFAULT_AUTHOR=
DEFAULT_STATUS=draft
ATABLOGGER_SPONSORS_FILE=

# Profile configuration
IS_DEFAULT_PROFILE=1

# Google CLI Profile Configuration
# Copy to .env.<profile-name> (e.g., .env.personal, .env.work)

# Mark this as the default profile (only one profile should have this set to 1)
IS_DEFAULT_PROFILE=0

# Google Analytics: Default GA4 property ID (numeric, e.g., 123456789)
# GOOGLE_ANALYTICS_PROPERTY_ID=

# Google Search Console: Default site URL
# GOOGLE_SEARCHCONSOLE_SITE=

# OAuth 2.0 credentials (from Google Cloud Console > APIs & Credentials > OAuth 2.0 Client IDs)
# Prompted during 'google auth login' and saved automatically into the active profile.
CLIENT_ID=
CLIENT_SECRET=

# token.json and credentials.json are auto-generated in the profile data directory:
#   .profiles/<profile-name>/credentials.json
#   .profiles/<profile-name>/token.json

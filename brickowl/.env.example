# Brick Owl CLI Configuration
# Get API credentials from: https://www.brickowl.com/mystore/settings
ACTIVE=true

# API Credentials
API_KEY=

# Browser login credentials used for browser-session commands
USERNAME=
PASSWORD=

# API Base URL
BASE_URL=https://api.brickowl.com/v1

# Browser settings
HEADLESS=true

# Response cache settings
CACHE_ENABLED=true
CACHE_TTL=3600

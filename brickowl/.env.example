# Brick Owl API Credentials
# Get your API key from: https://www.brickowl.com/myaccount/api

# API Key (required)
API_KEY=

# API Base URL (optional - defaults to production)
# BASE_URL=https://api.brickowl.com/v1

# Browser automation settings (optional)
# HEADLESS=true

# Response cache settings
# Enable/disable data-level caching (default: true)
CACHE_ENABLED=true
# Cache time-to-live in seconds (default: 3600)
CACHE_TTL=3600

# Profile marker (do not remove)
ACTIVE=true

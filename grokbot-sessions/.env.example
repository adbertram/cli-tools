# Grok Bot Sessions CLI configuration (shape only; no secret values here)
ACTIVE=true

# Non-authentication configuration
BASE_URL=https://api2.cursor.sh

# Optional overrides (read from the environment, never required):
#   GROKBOT_SESSIONS_APP_DIR  Grok Bot user-data directory
#                             (default: ~/Library/Application Support/Grok Bot)
#   GROKBOT_SESSIONS_API_BASE Connect RPC base URL (default: BASE_URL above)

# No CLI-owned credential exists. grokbot-sessions adopts the session the Grok
# Bot desktop app already holds; the token and machine id live in the app's
# sand-secrets.json and the macOS Keychain. Never copy them into a .env file.

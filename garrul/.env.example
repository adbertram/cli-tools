# Garrul CLI configuration (non-secret). There are no credentials to store:
# Garrul's only admin credential is the browser session from `garrul auth login`.
ACTIVE=true

# Any Garrul instance, including a local `wrangler dev` one.
BASE_URL=https://comments.adamtheautomator.com
# A site listed in the instance's ALLOWED_ORIGINS. Garrul's public /api/ routes require it.
EMBED_ORIGIN=https://adamtheautomator.com

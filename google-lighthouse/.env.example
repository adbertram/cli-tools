# Google Lighthouse CLI Wrapper Configuration
# Documentation: https://github.com/GoogleChrome/lighthouse#readme
ACTIVE=true

# Command used to launch the official npm Lighthouse package
CLI_COMMAND=npx
LIGHTHOUSE_NPM_PACKAGE=lighthouse@13.2.0

# Optional: Full path to an official Google Lighthouse executable.
# If set, CLI_COMMAND and LIGHTHOUSE_NPM_PACKAGE are ignored.
# CLI_PATH=

# Optional: Directory for audit artifacts and summaries
# GOOGLE_LIGHTHOUSE_DATA_DIR=~/Library/Application Support/cli-tools/google-lighthouse/audits

[
  {
    "name": "windows_path",
    "pattern": "(?<![A-Za-z0-9_])[A-Za-z]:\\\\[^\\s,;)]+(?<!\\.)",
    "transform": "windows_path"
  },
  {
    "name": "dotted_identifier",
    "pattern": "(?<![A-Za-z0-9_])(?:Az|Azure|Microsoft|System)\\.[A-Za-z][A-Za-z0-9_.]*(?![A-Za-z0-9_])",
    "transform": "dotted_identifier"
  },
  {
    "name": "file_name",
    "pattern": "\\b[A-Za-z0-9_-]+\\.(?:ps1|psm1|psd1|json|csv|cer|pfx|pem|zip|html|xml|config|txt|log|dll|exe|yml|yaml)\\b",
    "transform": "file_name"
  },
  {
    "name": "powershell_variable",
    "pattern": "\\$[A-Za-z_][A-Za-z0-9_:]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*|\\$_",
    "transform": "powershell_variable"
  },
  {
    "name": "powershell_parameter",
    "pattern": "(?<![A-Za-z0-9_])-[A-Z][A-Za-z0-9]*(?![A-Za-z0-9_])",
    "transform": "powershell_parameter"
  },
  {
    "name": "powershell_command",
    "pattern": "(?<![A-Za-z0-9_])(?:Add|Clear|Compress|Connect|ConvertFrom|ConvertTo|Copy|Disable|Disconnect|Enable|Export|ForEach|Get|Group|Import|Install|Invoke|Measure|Move|New|Out|Publish|Read|Register|Remove|Rename|Restart|Select|Set|Sort|Start|Stop|Test|Unregister|Update|Where|Write|convertfrom|convertto|foreach|select|where)-[A-Za-z][A-Za-z0-9]*(?![A-Za-z0-9_])",
    "transform": "powershell_command"
  },
  {
    "name": "pipe",
    "pattern": "\\|",
    "transform": "literal",
    "spoken": "pipe"
  },
  {
    "name": "percent_alias",
    "pattern": "(?<!\\S)%(?!\\S)",
    "transform": "literal",
    "spoken": "percent sign"
  }
]

# Non-secret configuration only. Reusable credentials belong in the CLI-tools
# secret manager; `facebook-ads auth login` saves a secret reference automatically.
BASE_URL=https://graph.facebook.com
API_VERSION=v26.0
HTTP_TIMEOUT=60
MAX_RETRIES=3
BASE_DELAY=1
MAX_DELAY=30
RETRY_JITTER=0.1
# Required token: facebook-ads-personal-access-token (default profile).
# Optional app secret: saved with `facebook-ads app-secret`.

# Non-secret auth profile marker (profile configuration only).
ACTIVE=true

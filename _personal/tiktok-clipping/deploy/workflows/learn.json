{
  "name": "TikTok clipping - improve strategy",
  "nodes": [
    {
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1,
              "triggerAtMinute": 7
            }
          ]
        }
      }
    },
    {
      "id": "manual-start",
      "name": "Manual start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "prepare-work",
      "name": "Prepare work",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "command": "=/usr/bin/env PATH='/opt/homebrew/opt/ffmpeg-full/bin:/Users/adam/.local/bin:/opt/homebrew/bin:/usr/bin:/bin' WHISPER_CPP_MODEL='/Users/adam/.local/share/cli-tools/whisper/models/ggml-small.en.bin' /Users/adam/.local/bin/tiktok-clipping jobs prepare --native-text --kind learn --config /opt/cli-tools/_personal/tiktok-clipping/deploy/config.json --n8n-execution-id '{{ $execution.id }}' --n8n-workflow-id '{{ $workflow.id }}'",
        "executeOnce": true
      }
    },
    {
      "id": "read-coordinator-result",
      "name": "Read coordinator result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw=$input.first().json.stdout; if(typeof raw!==\"string\" || raw.length>1048576) throw new Error(\"Invalid coordinator envelope\"); const d=JSON.parse(raw); if (!d || typeof d!==\"object\" || Array.isArray(d)) throw new Error(\"Invalid coordinator result\"); return [{json:d}];"
      }
    },
    {
      "id": "require-leased-job",
      "name": "Require leased job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$input.first().json;\nif(typeof d.ready!==\"boolean\") throw new Error(\"Missing readiness state\");\nif(!d.ready) return [];\nconst e=d.text;\nif(!e || e.schema_version!==1 || e.kind!==\"learn\" || e.job_id!==d.job_id || !/^[a-f0-9]{32}$/.test(e.job_id) || !/^[a-f0-9]{32}$/.test(e.attempt_id) || typeof d.task!==\"string\" || d.task.length>8192 || !Number.isFinite(e.model_deadline) || !Number.isFinite(e.expires_at) || e.expires_at<=Date.now()/1000 || e.model_deadline>=e.expires_at || !Number.isSafeInteger(d.max_payload_bytes) || d.max_payload_bytes<1024) throw new Error(\"Invalid original text attempt\");\nconst task=JSON.parse(d.task);\nif(Object.keys(task).length!==Object.keys(e).length || Object.keys(e).some(key=>JSON.stringify(task[key])!==JSON.stringify(e[key]))) throw new Error(\"Text task identity changed\");\nreturn [{json:d}];"
      }
    },
    {
      "id": "deepseek-analysis",
      "name": "DeepSeek analysis",
      "type": "n8n-nodes-agent-harnesses.deepSeekHarness",
      "typeVersion": 1,
      "position": [
        960,
        0
      ],
      "parameters": {
        "prompt": "={{$json.task}}",
        "profile": "headless",
        "options": {
          "workingDirectory": "/opt/cli-tools/_personal/tiktok-clipping",
          "patches": "={{$json.text.overlay_path}}",
          "timeout": "={{Math.max(1,Math.ceil($json.text.model_deadline-Date.now()/1000))}}"
        }
      },
      "credentials": {
        "deepSeekHarnessApi": {
          "id": "SCgsQg91RETeYSdk",
          "name": "DeepSeek Harness (adam-server)"
        }
      },
      "continueOnFail": true,
      "retryOnFail": false
    },
    {
      "id": "encode-proposal",
      "name": "Encode proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const job=$(\"Require leased job\").first().json;\nconst native=$input.first().json;\nif(!native || typeof native!==\"object\" || Array.isArray(native)) throw new Error(\"Invalid native text response\");\nconst failed=Object.prototype.hasOwnProperty.call(native,\"error\");\nlet receipt_json=typeof native.result===\"string\"?native.result:(failed && typeof native.stdout===\"string\"?native.stdout:null);\nconst native_failure=failed?{timed_out:native.timedOut===true,exit_code:Number.isInteger(native.exitCode)&&native.exitCode>=-255&&native.exitCode<=255?native.exitCode:null}:null;\nconst payload={envelope:job.text,receipt_json,native_failure};\n// If string escaping exceeds the transport budget, the coordinator reads the\n// fsynced original result.json instead. No usage or JSON is truncated.\nif(Buffer.byteLength(JSON.stringify(payload),\"utf8\")>job.max_payload_bytes) payload.receipt_json=null;\nconst raw=JSON.stringify(payload);\nif(Buffer.byteLength(raw,\"utf8\")>job.max_payload_bytes) throw new Error(\"Text transport budget exceeded\");\nconst stdinB64=Buffer.from(raw,\"utf8\").toString(\"base64\");\nif(!/^[A-Za-z0-9+/=]+$/.test(stdinB64)) throw new Error(\"Invalid transport encoding\");\nreturn [{json:{stdinB64}}];"
      }
    },
    {
      "id": "validate-and-execute",
      "name": "Validate and execute",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "command": "=printf '%s' '{{ $json.stdinB64 }}' | /usr/bin/base64 -D | /usr/bin/env PATH='/opt/homebrew/opt/ffmpeg-full/bin:/Users/adam/.local/bin:/opt/homebrew/bin:/usr/bin:/bin' WHISPER_CPP_MODEL='/Users/adam/.local/share/cli-tools/whisper/models/ggml-small.en.bin' /Users/adam/.local/bin/tiktok-clipping jobs apply-text --config /opt/cli-tools/_personal/tiktok-clipping/deploy/config.json --n8n-execution-id '{{ $execution.id }}' --n8n-workflow-id '{{ $workflow.id }}'",
        "executeOnce": true
      }
    },
    {
      "id": "read-operational-health",
      "name": "Read operational health",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2300,
        500
      ],
      "parameters": {
        "command": "PATH=/opt/homebrew/opt/ffmpeg-full/bin:/Users/adam/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin /Users/adam/.local/bin/tiktok-clipping status get --config /opt/cli-tools/_personal/tiktok-clipping/deploy/config.json </dev/null"
      }
    },
    {
      "id": "check-operational-health",
      "name": "Check operational health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2520,
        500
      ],
      "parameters": {
        "jsCode": "const raw=$input.first().json.stdout;\nif(typeof raw!==\"string\" || Buffer.byteLength(raw,\"utf8\")>1048576) throw new Error(\"Invalid operational health output\");\nconst d=JSON.parse(raw), h=d.health;\nif(!h || typeof h.actionable!==\"boolean\" || !Array.isArray(h.issues)) throw new Error(\"Missing operational health contract\");\nif(h.actionable) throw new Error(\"CLIPPING_OPERATIONAL_FAILURE \"+JSON.stringify({state:h.state,issues:h.issues.slice(0,20)}));\nreturn [{json:{state:d.state,health:h}}];"
      }
    },
    {
      "id": "complete-idle-work",
      "name": "Complete idle work",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        600
      ],
      "parameters": {
        "jsCode": "const d=$input.first().json;\nif(typeof d.ready!==\"boolean\") throw new Error(\"Missing readiness state\");\nconst action=d.action_result || d;\nreturn !d.ready && action.state!==\"visual_pending\" ? [{json:d}] : [];"
      }
    }
  ],

{
  "name": "TikTok clipping - discover and publish",
  "nodes": [
    {
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "manual-start",
      "name": "Manual start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "prepare-work",
      "name": "Prepare work",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "command": "/usr/bin/env PATH='/opt/homebrew/opt/ffmpeg-full/bin:/Users/adam/.local/bin:/opt/homebrew/bin:/usr/bin:/bin' WHISPER_CPP_MODEL='/Users/adam/.local/share/cli-tools/whisper/models/ggml-small.en.bin' /Users/adam/.local/bin/tiktok-clipping jobs prepare --kind clip --config /opt/cli-tools/_personal/tiktok-clipping/deploy/config.json",
        "executeOnce": true
      }
    },
    {
      "id": "read-coordinator-result",
      "name": "Read coordinator result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw=$input.first().json.stdout; if(typeof raw!==\"string\" || raw.length>1048576) throw new Error(\"Invalid coordinator envelope\"); const d=JSON.parse(raw); if (!d || typeof d!==\"object\" || Array.isArray(d)) throw new Error(\"Invalid coordinator result\"); return [{json:d}];"
      }
    },
    {
      "id": "require-leased-job",
      "name": "Require leased job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$input.first().json; if(typeof d.ready!==\"boolean\") throw new Error(\"Missing readiness state\"); if(!d.ready) return []; for(const key of [\"job_id\",\"lease_token\",\"input_digest\",\"policy_digest\",\"prompt\"]) if(typeof d[key]!==\"string\" || !d[key]) throw new Error(\"Missing job context\"); if(d.prompt.length>1048576) throw new Error(\"Prompt too large\"); return [{json:d}];"
      }
    },
    {
      "id": "deepseek-analysis",
      "name": "DeepSeek analysis",
      "type": "n8n-nodes-agent-harnesses.deepSeekHarness",
      "typeVersion": 1,
      "position": [
        960,
        0
      ],
      "parameters": {
        "prompt": "={{$json.prompt}}",
        "profile": "headless",
        "options": {
          "workingDirectory": "/opt/cli-tools/_personal/tiktok-clipping",
          "patches": "/opt/cli-tools/_personal/tiktok-clipping/deploy/deepseek-analysis.yml",
          "timeout": 120
        }
      },
      "credentials": {
        "deepSeekHarnessApi": {
          "id": "SCgsQg91RETeYSdk",
          "name": "DeepSeek Harness (adam-server)"
        }
      }
    },
    {
      "id": "encode-proposal",
      "name": "Encode proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const job=$(\"Require leased job\").first().json; const result=$input.first().json.result; if(typeof result!==\"string\" || result.length>65536) throw new Error(\"Invalid model result size\"); const payload={job_id:job.job_id,lease_token:job.lease_token,input_digest:job.input_digest,policy_digest:job.policy_digest,proposal:{result}}; const stdinB64=Buffer.from(JSON.stringify(payload),\"utf8\").toString(\"base64\"); if(!/^[A-Za-z0-9+/=]+$/.test(stdinB64)) throw new Error(\"Invalid transport encoding\"); return [{json:{stdinB64}}];"
      }
    },
    {
      "id": "validate-and-execute",
      "name": "Validate and execute",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "command": "=printf '%s' '{{ $json.stdinB64 }}' | /usr/bin/base64 -D | /usr/bin/env PATH='/opt/homebrew/opt/ffmpeg-full/bin:/Users/adam/.local/bin:/opt/homebrew/bin:/usr/bin:/bin' WHISPER_CPP_MODEL='/Users/adam/.local/share/cli-tools/whisper/models/ggml-small.en.bin' /Users/adam/.local/bin/tiktok-clipping jobs apply --config /opt/cli-tools/_personal/tiktok-clipping/deploy/config.json",
        "executeOnce": true
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Prepare work",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual start": {
      "main": [
        [
          {
            "node": "Prepare work",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare work": {
      "main": [
        [
          {
            "node": "Read coordinator result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read coordinator result": {
      "main": [
        [
          {
            "node": "Require leased job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Require leased job": {
      "main": [
        [
          {
            "node": "DeepSeek analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DeepSeek analysis": {
      "main": [
        [
          {
            "node": "Encode proposal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Encode proposal": {
      "main": [
        [
          {
            "node": "Validate and execute",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 1800,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "timezone": "America/Chicago"
  }
}

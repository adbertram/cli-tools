{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:microworker:merged",
  "title": "MicroWorker merged discovery run",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "merged_at", "sites", "tasks"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "merged_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sites": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "error", "fetched_at", "task_count"],
        "properties": {
          "status": {"enum": ["ok", "auth_failed", "no_cli", "no_account", "error"]},
          "error": {"type": ["string", "null"]},
          "fetched_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "task_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "tasks": {"type": "array", "items": {"$ref": "urn:microworker:task"}}
  }
}

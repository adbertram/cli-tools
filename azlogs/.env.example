# Azure Web App Configuration
# Set here, pass via --app/--resource-group flags, or run 'azlogs auth login'

# Set to 1 for the default profile
IS_DEFAULT_PROFILE=1

# Optional: Azure Web App name (also: azlogs --app <name>)
# AZLOGS_APP_NAME=

# Optional: Azure Resource Group (also: azlogs --resource-group <name>)
# AZLOGS_RESOURCE_GROUP=

# Optional: Custom data directory for downloaded packages (default: ./data/)
# AZLOGS_DATA_DIR=

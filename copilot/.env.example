# =====================================================================
# Copilot CLI profile template
# ---------------------------------------------------------------------
# Copy this file to your config directory before editing:
#
#   macOS / Linux:
#     mkdir -p ~/.local/share/cli-tools/copilot/authentication_profiles/default
#     cp .env.example ~/.local/share/cli-tools/copilot/authentication_profiles/default/.env
#
#   Windows (PowerShell):
#     New-Item -ItemType Directory -Force "$env:APPDATA\cli-tools\copilot\authentication_profiles\default"
#     Copy-Item .env.example "$env:APPDATA\cli-tools\copilot\authentication_profiles\default\.env"
#
# Then edit the copy. Do NOT keep edited .env files inside the project
# directory; the CLI reads only the canonical cli-tools profile layout.
#
# Secrets (AZURE_CLIENT_SECRET, M365_SDK_CLIENT_SECRET, DIRECTLINE_SECRET)
# are stored by the CLI-tools secret manager. This profile .env stores only
# secret://... placeholders after you set them with:
#
#   copilot config set-secret AZURE_CLIENT_SECRET
#
# Per-profile naming: place additional profiles at
#   ~/.local/share/cli-tools/copilot/authentication_profiles/<name>/.env
# and mark whichever you want active with IS_DEFAULT_PROFILE=1.
# =====================================================================

# Set to 1 to make this the default profile when no --profile flag is given
IS_DEFAULT_PROFILE=1

# ---------------------------------------------------------------------
# Required — Dataverse environment URL (e.g., https://yourorg.crm.dynamics.com)
# Find this in Power Platform admin center
# (https://admin.powerplatform.microsoft.com)
# Prompted during 'copilot auth login' and saved automatically.
# ---------------------------------------------------------------------
DATAVERSE_URL=

# ---------------------------------------------------------------------
# Optional — Power Platform environment ID (for Power Apps API calls)
# Format: Default-<tenant-id> or a specific environment GUID
# ---------------------------------------------------------------------
DATAVERSE_ENVIRONMENT_ID=

# ---------------------------------------------------------------------
# Optional — Service Principal authentication (alternative to az login)
# Leave AZURE_TENANT_ID and AZURE_CLIENT_ID blank to use Azure CLI auth.
# AZURE_CLIENT_SECRET is stored by the CLI-tools secret manager; this field
# becomes a secret://... placeholder after `copilot config set-secret`.
# ---------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Optional — pin which Azure CLI identity this profile expects
# Used by `copilot auth login --profile <name>` to enforce the right user.
# ---------------------------------------------------------------------
AZURE_CLI_EXPECTED_USER=

# ---------------------------------------------------------------------
# Optional — Direct Line authentication for agent testing
# Get from Copilot Studio > Agent > Settings > Channels > Direct Line.
# DIRECTLINE_SECRET is stored by the CLI-tools secret manager; this field
# becomes a secret://... placeholder after:
#   copilot config set-secret DIRECTLINE_SECRET
# ---------------------------------------------------------------------
DIRECTLINE_SECRET=

# ---------------------------------------------------------------------
# Optional — Entra ID authentication for agent testing
# ---------------------------------------------------------------------
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_SCOPE=https://api.powerplatform.com/.default
BOT_TOKEN_ENDPOINT=

# Optional - M365 Agents SDK (for agents using "Authenticate with Microsoft" integrated auth)
M365_SDK_CLIENT_ID=
M365_SDK_TENANT_ID=
M365_SDK_CLIENT_SECRET=
